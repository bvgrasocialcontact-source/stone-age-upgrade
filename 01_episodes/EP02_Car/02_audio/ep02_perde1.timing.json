  {
   "start": 0.05,
   "end": 1.57,
   "text": "Three hundred thousand years ago,",
   "tags": [
    "excited"
   ],
   "para_end": false
  },
  {
   "start": 1.57,
   "end": 3.69,
   "text": "you wake up in the tall grass...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 3.88,
   "end": 4.93,
   "text": "and right next to you,",
   "tags": [],
