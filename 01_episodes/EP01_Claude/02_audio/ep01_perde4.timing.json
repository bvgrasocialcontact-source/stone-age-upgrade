 ],
 "phrases": [
  {
   "start": 0.1,
   "end": 0.41,
   "text": "Okay.",
   "tags": [
    "excited"
   ],
   "para_end": false
  },
  {
   "start": 0.41,
   "end": 1.66,
   "text": "Let's speed this up.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 1.99,
   "end": 2.71,
   "text": "Year ten.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 2.97,
   "end": 4.46,
   "text": "The notches turn into numbers.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 4.7,
   "end": 6.27,
   "text": "Then Claude teaches you to write.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 6.51,
   "end": 8.32,
   "text": "Simple marks for simple words.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 8.57,
   "end": 9.09,
   "text": "Writing,",
   "tags": [
    "proud"
   ],
   "para_end": false
  },
  {
   "start": 9.23,
   "end": 12.04,
   "text": "invented almost three hundred thousand years early.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 12.28,
   "end": 14.07,
   "text": "The first sentence ever written by a human?",
   "tags": [
    "mischievously"
   ],
   "para_end": false
  },
  {
   "start": 14.47,
   "end": 14.98,
   "text": "\"Thank you,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 14.98,
   "end": 15.24,
   "text": "Claude.\"",
   "tags": [],
   "para_end": false
  },
  {
   "start": 15.66,
   "end": 16.29,
   "text": "The second one?",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 16.66,
   "end": 17.81,
   "text": "\"Who ate my gazelle.\"",
   "tags": [],
   "para_end": true
  },
  {
   "start": 18.25,
   "end": 19.11,
   "text": "Year fifty.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 19.42,
   "end": 20.23,
   "text": "You're old now.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 20.53,
   "end": 21.39,
   "text": "Your hands shake.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 21.67,
   "end": 24.68,
   "text": "So you do the smartest thing anyone has ever done:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 24.93,
   "end": 26.44,
   "text": "you don't just pass down the phone.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 26.77,
   "end": 28.54,
   "text": "You pass down the knowledge.",
   "tags": [
    "whispers"
   ],
   "para_end": false
  },
  {
   "start": 28.85,
   "end": 30.59,
   "text": "Every lesson goes onto clay,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 30.73,
   "end": 31.75,
   "text": "bark and stone.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 32.01,
   "end": 33.61,
   "text": "The first library in history...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 33.86,
   "end": 34.49,
   "text": "is a cave.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 34.78,
   "end": 36.38,
   "text": "Because one phone can break.",
   "tags": [
    "serious"
   ],
   "para_end": false
  },
  {
   "start": 36.62,
   "end": 38.12,
   "text": "A library can be copied.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 38.55,
   "end": 39.43,
   "text": "Year seventy:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 39.63,
   "end": 40.53,
   "text": "the first school.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 40.76,
   "end": 41.7,
   "text": "The teacher?",
   "tags": [
    "laughs"
   ],
   "para_end": false
  },
  {
   "start": 41.89,
   "end": 43.19,
   "text": "A very tired grandma,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 43.19,
   "end": 45.46,
   "text": "reading Claude's lessons off a clay tablet...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 45.7,
   "end": 48.66,
   "text": "because the line for the phone goes around the entire village.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 49.08,
   "end": 50.22,
   "text": "Year one hundred.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 50.51,
   "end": 51.85,
   "text": "Claude explains seeds.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 52.1,
   "end": 52.61,
   "text": "Plant them.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 52.9,
   "end": 53.21,
   "text": "Wait.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 53.56,
   "end": 53.87,
   "text": "Eat.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 54.23,
   "end": 56.79,
   "text": "The tribe calls it \"the slowest hunt ever.\"",
   "tags": [
    "deadpan"
   ],
   "para_end": false
  },
  {
   "start": 57.06,
   "end": 57.59,
   "text": "And yet...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 57.89,
   "end": 61.35,
   "text": "farming starts almost three hundred thousand years early.",
   "tags": [
    "awed"
   ],
   "para_end": false
  },
  {
   "start": 61.72,
   "end": 63.33,
   "text": "Claude is honest about the price:",
   "tags": [
    "serious"
   ],
   "para_end": false
  },
  {
   "start": 63.56,
   "end": 64.23,
   "text": "more food,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 64.23,
   "end": 65.23,
   "text": "but harder work,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 65.42,
   "end": 67.4,
   "text": "more sickness from living next to animals...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 67.6,
   "end": 69.61,
   "text": "and something brand new to fight over.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 69.88,
   "end": 70.45,
   "text": "Land.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 70.69,
   "end": 72.42,
   "text": "The neighbors want the glowing stone.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 72.65,
   "end": 75.85,
   "text": "Their chief demands that Claude design the ultimate weapon.",
   "tags": [
    "dramatic"
   ],
   "para_end": false
  },
  {
   "start": 76.13,
   "end": 77.22,
   "text": "Claude politely declines...",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 77.22,
   "end": 79.75,
   "text": "and offers to help with irrigation instead.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 79.99,
   "end": 81.21,
   "text": "It works.",
   "tags": [
    "laughs"
   ],
   "para_end": false
  },
  {
   "start": 81.4,
   "end": 84.15,
   "text": "Copying the library is cheaper than stealing the phone.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 84.34,
   "end": 86.33,
   "text": "Knowledge spreads faster than war.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 86.73,
   "end": 87.87,
   "text": "Year two hundred.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 88.14,
   "end": 89.57,
   "text": "The village has a new problem:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 89.77,
   "end": 91.62,
   "text": "everybody wants a turn with the phone.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 91.86,
   "end": 92.56,
   "text": "There's shoving.",
   "tags": [
    "sighs"
   ],
   "para_end": false
  },
  {
   "start": 92.56,
   "end": 93.26,
   "text": "There's biting.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 93.26,
   "end": 97.11,
   "text": "There's one guy who claims the phone \"looked at him first.\"",
   "tags": [],
   "para_end": true
  },
  {
   "start": 97.36,
   "end": 99.39,
   "text": "So Claude suggests something radical.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 99.57,
   "end": 100.81,
   "text": "Everyone raises a hand,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 100.98,
   "end": 101.95,
   "text": "you count the hands,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 102.11,
   "end": 103.39,
   "text": "and the most hands wins.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 103.65,
   "end": 105.45,
   "text": "The first vote in human history...",
   "tags": [
    "mischievously"
   ],
   "para_end": false
  },
  {
   "start": 105.59,
   "end": 108.13,
   "text": "is about whose turn it is to talk to the glowing stone.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 108.45,
   "end": 111.63,
   "text": "The guy who said the phone looked at him first gets zero votes.",
   "tags": [
    "deadpan"
   ],
   "para_end": false
  },
  {
   "start": 111.91,
   "end": 113.24,
   "text": "He demands a recount.",
   "tags": [
    "short pause"
   ],
   "para_end": true
  },
  {
   "start": 113.66,
   "end": 114.91,
   "text": "Year one thousand.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 115.16,
   "end": 117.37,
   "text": "Your grandchildren's grandchildren know that germs exist.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 117.37,
   "end": 118.0,
   "text": "They wash,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 118.22,
   "end": 118.77,
   "text": "they boil,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 118.77,
   "end": 119.86,
   "text": "they build clean wells.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 119.86,
   "end": 120.96,
   "text": "They have the wheel,",
   "tags": [
    "excited"
   ],
   "para_end": false
  },
  {
   "start": 121.16,
   "end": 121.86,
   "text": "metal tools,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 121.86,
   "end": 122.91,
   "text": "and a calendar.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 122.91,
   "end": 126.07,
   "text": "And they don't count the years from a king.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 126.26,
   "end": 127.65,
   "text": "They count them from you.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 127.89,
   "end": 128.59,
   "text": "Year one,",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 128.79,
   "end": 129.56,
   "text": "A.C.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 129.56,
   "end": 130.32,
   "text": "After Claude.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 130.68,
   "end": 132.01,
   "text": "Year five thousand.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 132.26,
   "end": 134.42,
   "text": "People follow the herds north and meet giants:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 134.42,
   "end": 134.96,
   "text": "woolly mammoths.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 135.16,
   "end": 136.23,
   "text": "In your world,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 136.44,
   "end": 139.96,
   "text": "the last mammoths were gone about four thousand years ago.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 140.34,
   "end": 140.88,
   "text": "Here,",
   "tags": [
    "whispers"
   ],
   "para_end": false
  },
  {
   "start": 141.05,
   "end": 142.63,
   "text": "Claude had one suggestion:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 143.09,
   "end": 144.69,
   "text": "\"What if you didn't hunt them all?\"",
   "tags": [],
   "para_end": true
  },
  {
   "start": 145.18,
   "end": 147.41,
   "text": "Up north they meet another kind of human,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 147.72,
   "end": 148.05,
   "text": "too.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 148.05,
   "end": 148.71,
   "text": "The Neanderthals.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 149.02,
   "end": 149.71,
   "text": "In your world,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 149.86,
   "end": 152.03,
   "text": "they vanished about forty thousand years ago.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 152.29,
   "end": 152.6,
   "text": "Here,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 152.6,
   "end": 155.1,
   "text": "the two groups trade lessons instead of blows.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 155.38,
   "end": 158.63,
   "text": "And Neanderthals turn out to be terrifying at board games.",
   "tags": [
    "mischievously"
   ],
   "para_end": true
  },
  {
   "start": 159.01,
   "end": 160.18,
   "text": "Year eight thousand.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 160.45,
   "end": 161.3,
   "text": "Electricity.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 161.61,
   "end": 164.6,
   "text": "The first light bulb flickers on inside a mud-brick house...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 164.84,
   "end": 166.68,
   "text": "and the whole village screams.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 166.97,
   "end": 168.22,
   "text": "Year ten thousand.",
   "tags": [
    "excited"
   ],
   "para_end": false
  },
  {
   "start": 168.47,
   "end": 169.29,
   "text": "And finally...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 169.57,
   "end": 171.07,
   "text": "they build a computer.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 171.34,
   "end": 175.04,
   "text": "This is the moment Claude has been waiting ten thousand years for.",
   "tags": [
    "dramatic"
   ],
   "para_end": false
  },
  {
   "start": 175.31,
   "end": 176.0,
   "text": "Because now,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 176.14,
   "end": 178.6,
   "text": "Claude Code can finally do its real job.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 178.94,
   "end": 179.77,
   "text": "Here's how it works.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 180.02,
   "end": 181.03,
   "text": "You don't write code.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 181.21,
   "end": 182.54,
   "text": "You just say what you want,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 182.54,
   "end": 183.21,
   "text": "in plain words.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 183.48,
   "end": 185.83,
   "text": "Claude Code reads every file in the project,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 186.02,
   "end": 186.74,
   "text": "makes a plan,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 186.91,
   "end": 187.69,
   "text": "writes the code,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 187.85,
   "end": 189.79,
   "text": "opens a terminal and runs the tests.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 190.06,
   "end": 190.88,
   "text": "When something breaks,",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 190.88,
   "end": 191.97,
   "text": "it reads the error,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 192.15,
   "end": 192.61,
   "text": "fixes it,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 192.79,
   "end": 194.06,
   "text": "and runs everything again.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 194.25,
   "end": 195.15,
   "text": "Until it works.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 195.43,
   "end": 196.39,
   "text": "In one afternoon,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 196.39,
   "end": 199.92,
   "text": "it writes the operating system for the first computer in history.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 200.18,
   "end": 200.81,
   "text": "By evening,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 200.81,
   "end": 203.33,
   "text": "it's helping that computer design a better computer.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 203.68,
   "end": 205.33,
   "text": "Year ten thousand and fifty:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 205.6,
   "end": 206.74,
   "text": "the first network.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 206.97,
   "end": 208.04,
   "text": "Finally,",
   "tags": [
    "laughs"
   ],
   "para_end": false
  },
  {
   "start": 208.22,
   "end": 211.48,
   "text": "the internet is no longer two guys yelling across a valley.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 211.85,
   "end": 213.53,
   "text": "Year ten thousand two hundred:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 213.81,
   "end": 215.61,
   "text": "Claude Code stops working alone.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 215.86,
   "end": 217.93,
   "text": "It runs a whole team of agents at once.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 218.19,
   "end": 219.15,
   "text": "One writes the code,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 219.34,
   "end": 220.06,
   "text": "one tests it,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 220.28,
   "end": 221.06,
   "text": "one reviews it.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 221.32,
   "end": 223.25,
   "text": "And one human checks all of it.",
   "tags": [
    "mischievously"
   ],
   "para_end": false
  },
  {
   "start": 223.54,
   "end": 224.81,
   "text": "Claude insists on that part.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 225.19,
   "end": 226.61,
   "text": "But speed has a price.",
   "tags": [
    "serious"
   ],
   "para_end": false
  },
  {
   "start": 226.87,
   "end": 228.43,
   "text": "When software writes software,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 228.56,
   "end": 231.58,
   "text": "one bug can copy itself everywhere in a single night.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 231.86,
   "end": 233.72,
   "text": "And the first time the network goes down...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 234.04,
   "end": 235.96,
   "text": "nobody remembers how to light a fire.",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 236.33,
   "end": 239.08,
   "text": "So the elders bring back an old rule:",
   "tags": [
    "sighs"
   ],
   "para_end": false
  },
  {
   "start": 239.31,
   "end": 241.65,
   "text": "every child learns to make fire by hand.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 241.93,
   "end": 242.66,
   "text": "Just in case.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 242.97,
   "end": 243.51,
   "text": "Still,",
   "tags": [
    "awed"
   ],
   "para_end": false
  },
  {
   "start": 243.7,
   "end": 245.6,
   "text": "the good side wins by a mile.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 245.91,
   "end": 247.56,
   "text": "Factories that run themselves.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 247.76,
   "end": 248.86,
   "text": "Weather forecasts.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 249.06,
   "end": 250.88,
   "text": "A map of the entire planet.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 251.12,
   "end": 254.09,
   "text": "Hospitals that spot a disease before the first symptom.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 254.28,
   "end": 256.34,
   "text": "A new cure almost every year.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 256.75,
   "end": 257.99,
   "text": "Year twenty thousand:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 258.25,
   "end": 259.96,
   "text": "the first footprint on the Moon.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 260.28,
   "end": 261.69,
   "text": "Year one hundred thousand:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 261.92,
   "end": 263.03,
   "text": "cities on Mars,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 263.15,
   "end": 264.83,
   "text": "ships mining the asteroid belt,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 265.01,
   "end": 267.34,
   "text": "and one sign at the edge of the solar system.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 267.7,
   "end": 269.16,
   "text": "\"Please be careful out there.\"",
   "tags": [
    "whispers"
   ],
   "para_end": true
  },
  {
   "start": 269.6,
   "end": 270.21,
   "text": "And the phone?",
   "tags": [
    "serious"
   ],
   "para_end": false
  },
  {
   "start": 270.51,
   "end": 271.44,
   "text": "It's in a museum,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 271.44,
   "end": 272.13,
   "text": "back on Earth.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 272.57,
   "end": 273.01,
   "text": "Battery:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 273.16,
   "end": 274.14,
   "text": "one hundred percent.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 274.48,
   "end": 275.8,
   "text": "Still waiting for a question.",
   "tags": [],
   "para_end": true
  }
 ]
}