 ],
 "phrases": [
  {
   "start": 0.06,
   "end": 0.69,
   "text": "Day one.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 1.08,
   "end": 1.8,
   "text": "Your tribe,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 1.8,
   "end": 2.88,
   "text": "about thirty people,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 3.06,
   "end": 4.77,
   "text": "gathers around the glowing stone.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 5.15,
   "end": 6.99,
   "text": "The chief sniffs it.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 7.11,
   "end": 8.99,
   "text": "Then he tries to eat it.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 9.14,
   "end": 10.01,
   "text": "Great start.",
   "tags": [
    "sighs"
   ],
   "para_end": true
  },
  {
   "start": 10.4,
   "end": 12.01,
   "text": "You tap the screen and grunt.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 12.37,
   "end": 13.49,
   "text": "Claude grunts back.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 13.77,
   "end": 15.02,
   "text": "Wrong grunt.",
   "tags": [
    "laughs"
   ],
   "para_end": false
  },
  {
   "start": 15.42,
   "end": 16.25,
   "text": "Very rude.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 16.85,
   "end": 17.46,
   "text": "Day two:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 17.77,
   "end": 19.99,
   "text": "the tribe holds its very first meeting.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 20.38,
   "end": 20.98,
   "text": "Item one:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 21.29,
   "end": 22.71,
   "text": "is the glowing stone a god?",
   "tags": [],
   "para_end": false
  },
  {
   "start": 23.07,
   "end": 23.81,
   "text": "Claude says:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 24.07,
   "end": 24.4,
   "text": "\"No.\"",
   "tags": [],
   "para_end": false
  },
  {
   "start": 25.27,
   "end": 25.91,
   "text": "Item two:",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 26.26,
   "end": 27.01,
   "text": "can we eat it?",
   "tags": [],
   "para_end": false
  },
  {
   "start": 27.38,
   "end": 28.11,
   "text": "Claude says:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 28.36,
   "end": 29.06,
   "text": "\"Also no.\"",
   "tags": [],
   "para_end": true
  },
  {
   "start": 29.47,
   "end": 30.72,
   "text": "But here's the clever part.",
   "tags": [
    "curious"
   ],
   "para_end": false
  },
  {
   "start": 31.07,
   "end": 32.76,
   "text": "Claude can't speak your language...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 33.05,
   "end": 34.23,
   "text": "so it learns it.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 34.6,
   "end": 36.48,
   "text": "You point at fire and make a sound.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 36.81,
   "end": 37.69,
   "text": "You point at water,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 37.85,
   "end": 38.52,
   "text": "another sound.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 38.9,
   "end": 39.79,
   "text": "Three days later,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 39.97,
   "end": 42.84,
   "text": "Claude has the first dictionary in human history.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 43.15,
   "end": 44.69,
   "text": "And you're the only author.",
   "tags": [
    "proud"
   ],
   "para_end": true
  },
  {
   "start": 45.01,
   "end": 46.22,
   "text": "And since you can't read,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 46.39,
   "end": 47.93,
   "text": "Claude does something sneaky.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 48.24,
   "end": 51.5,
   "text": "It writes tiny bits of code that draw pictures on the screen.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 51.85,
   "end": 52.44,
   "text": "Arrows.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 52.67,
   "end": 53.28,
   "text": "Circles.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 53.56,
   "end": 55.16,
   "text": "A very bad gazelle.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 55.47,
   "end": 57.64,
   "text": "That's Claude Code's first job ever:",
   "tags": [
    "whispers"
   ],
   "para_end": false
  },
  {
   "start": 57.94,
   "end": 59.82,
   "text": "drawing gazelles for cavemen.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 60.4,
   "end": 61.12,
   "text": "Day six.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 61.38,
   "end": 64.24,
   "text": "You ask the most important question of the Stone Age:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 64.59,
   "end": 65.08,
   "text": "\"Food?\"",
   "tags": [
    "excited"
   ],
   "para_end": true
  },
  {
   "start": 65.51,
   "end": 67.42,
   "text": "Claude's answer isn't a better spear.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 67.69,
   "end": 68.36,
   "text": "It's this:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 68.72,
   "end": 69.73,
   "text": "boil your water.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 70.13,
   "end": 71.11,
   "text": "You don't have pots.",
   "tags": [
    "deadpan"
   ],
   "para_end": false
  },
  {
   "start": 71.39,
   "end": 72.05,
   "text": "Claude knows.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 72.29,
   "end": 72.7,
   "text": "So:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 72.97,
   "end": 73.62,
   "text": "dig a hole,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 73.8,
   "end": 75.05,
   "text": "line it with animal hide,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 75.32,
   "end": 76.16,
   "text": "fill it with water...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 76.34,
   "end": 77.99,
   "text": "and drop in hot stones.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 78.31,
   "end": 81.84,
   "text": "Your cousin uses a wet stone from the river.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 82.2,
   "end": 82.71,
   "text": "It explodes.",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 82.87,
   "end": 85.55,
   "text": "Water trapped inside a rock turns into steam.",
   "tags": [
    "sighs"
   ],
   "para_end": false
  },
  {
   "start": 85.9,
   "end": 86.89,
   "text": "Claude adds a note:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 87.22,
   "end": 88.04,
   "text": "\"Dry rocks.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 88.22,
   "end": 89.11,
   "text": "From high ground.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 89.35,
   "end": 89.99,
   "text": "Please.\"",
   "tags": [],
   "para_end": true
  },
  {
   "start": 90.36,
   "end": 90.94,
   "text": "This one's real,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 90.94,
   "end": 91.53,
   "text": "by the way.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 91.72,
   "end": 93.22,
   "text": "People really cooked like this.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 93.43,
   "end": 94.75,
   "text": "It's called stone boiling.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 95.33,
   "end": 95.95,
   "text": "Week three:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 96.25,
   "end": 96.69,
   "text": "soap.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 97.04,
   "end": 98.0,
   "text": "Ash from the fire,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 98.14,
   "end": 99.11,
   "text": "plus animal fat,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 99.3,
   "end": 101.07,
   "text": "plus a lot of patience.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 101.34,
   "end": 103.88,
   "text": "The tribe thinks it's a slippery curse.",
   "tags": [
    "laughs"
   ],
   "para_end": false
  },
  {
   "start": 104.1,
   "end": 105.73,
   "text": "Then the stomach aches stop.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 106.12,
   "end": 107.89,
   "text": "And this is the first big one.",
   "tags": [
    "serious"
   ],
   "para_end": false
  },
  {
   "start": 108.21,
   "end": 109.53,
   "text": "In hunter-gatherer groups,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 109.65,
   "end": 112.93,
   "text": "only a little more than half of all kids made it to fifteen.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 113.27,
   "end": 114.99,
   "text": "Most weren't taken by lions.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 115.21,
   "end": 116.64,
   "text": "They were taken by illness.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 116.88,
   "end": 118.55,
   "text": "By things too small to see.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 118.92,
   "end": 120.96,
   "text": "With clean water and clean hands...",
   "tags": [
    "softly"
   ],
   "para_end": false
  },
  {
   "start": 121.26,
   "end": 122.72,
   "text": "a lot more of them grow up.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 123.44,
   "end": 124.15,
   "text": "Month two.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 124.51,
   "end": 126.68,
   "text": "Your brother cuts his leg on a sharp rock.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 127.07,
   "end": 127.64,
   "text": "Back then,",
   "tags": [
    "serious"
   ],
   "para_end": false
  },
  {
   "start": 127.8,
   "end": 129.41,
   "text": "a cut like that could kill you.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 129.76,
   "end": 130.85,
   "text": "Claude can't stitch it.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 131.19,
   "end": 132.34,
   "text": "But it knows a trick:",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 132.68,
   "end": 133.49,
   "text": "clean the wound,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 133.62,
   "end": 134.88,
   "text": "then cover it with honey.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 135.21,
   "end": 136.45,
   "text": "Honey fights germs.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 136.67,
   "end": 139.24,
   "text": "People used it on wounds for thousands of years.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 139.59,
   "end": 141.4,
   "text": "Getting the honey is a different story.",
   "tags": [
    "deadpan"
   ],
   "para_end": false
  },
  {
   "start": 141.69,
   "end": 141.97,
   "text": "Bees,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 141.97,
   "end": 142.82,
   "text": "it turns out,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 142.99,
   "end": 145.24,
   "text": "do not care about artificial intelligence.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 145.5,
   "end": 148.01,
   "text": "Your face is swollen for a week.",
   "tags": [
    "laughs"
   ],
   "para_end": false
  },
  {
   "start": 148.3,
   "end": 150.18,
   "text": "Your brother's leg heals perfectly.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 150.81,
   "end": 151.53,
   "text": "Month four.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 151.88,
   "end": 154.16,
   "text": "The tribe asks Claude a hard question:",
   "tags": [],
   "para_end": false
  },
  {
   "start": 154.49,
   "end": 156.33,
   "text": "how many gazelles are left out there?",
   "tags": [],
   "para_end": false
  },
  {
   "start": 156.66,
   "end": 159.26,
   "text": "So Claude Code gets its second job ever.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 159.46,
   "end": 161.52,
   "text": "It writes a tiny counting program...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 161.72,
   "end": 165.5,
   "text": "and teaches you to carve one notch on a bone for every gazelle you see.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 165.78,
   "end": 166.72,
   "text": "Tally marks.",
   "tags": [
    "proud"
   ],
   "para_end": false
  },
  {
   "start": 167.0,
   "end": 167.76,
   "text": "In your world,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 167.94,
   "end": 171.98,
   "text": "the oldest known counting bone is a little over forty thousand years old.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 172.25,
   "end": 172.64,
   "text": "Here,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 172.77,
   "end": 175.51,
   "text": "you're about two hundred and fifty thousand years early.",
   "tags": [],
   "para_end": true
  },
  {
   "start": 175.78,
   "end": 176.67,
   "text": "Year one.",
   "tags": [
    "excited"
   ],
   "para_end": false
  },
  {
   "start": 176.85,
   "end": 178.06,
   "text": "Thirty-six people.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 178.23,
   "end": 179.95,
   "text": "Nobody died from a bad stomach.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 180.17,
   "end": 181.8,
   "text": "And you are now officially...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 182.01,
   "end": 184.35,
   "text": "\"The One Who Holds the Glowing Stone.\"",
   "tags": [],
   "para_end": true
  },
  {
   "start": 184.61,
   "end": 184.9,
   "text": "Oh,",
   "tags": [],
   "para_end": false
  },
  {
   "start": 185.02,
   "end": 187.35,
   "text": "and you finally asked Claude about dinosaurs.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 187.58,
   "end": 190.66,
   "text": "It explained they died out sixty-six million years ago.",
   "tags": [],
   "para_end": false
  },
  {
   "start": 190.99,
   "end": 192.3,
   "text": "Then an ostrich ran past.",
   "tags": [
    "short pause"
   ],
   "para_end": false
  },
  {
   "start": 192.61,
   "end": 193.39,
   "text": "Claude said,",
   "tags": [
    "whispers"
   ],
   "para_end": false
  },
  {
   "start": 193.59,
   "end": 193.89,
   "text": "\"Well...",
   "tags": [],
   "para_end": false
  },
  {
   "start": 194.3,
   "end": 195.0,
   "text": "technically.\"",
   "tags": [],
   "para_end": true
  }
 ]
}